# ADANSI Environment Configuration
# Copy this to .env and fill in your values

# App
APP_NAME=ADANSI
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production

# Supabase (Database + Auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# PostgreSQL (direct connection for SQLAlchemy)
# Get this from Supabase Dashboard -> Settings -> Database -> Connection string
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Redis / Upstash
REDIS_URL=rediss://default:[token]@[host]:[port]

# Payment provider selection: sandbox | paystack | hubtel
# Use "paystack" for development so you can test the real card payment flow with Paystack test keys.
# Switch to "hubtel" in production — the provider abstraction layer means no code changes required.
PAYMENT_PROVIDER=paystack

# Hubtel (MoMo API — production target / MTN MoMo Fintech Lab partner)
HUBTEL_CLIENT_ID=your-hubtel-client-id
HUBTEL_CLIENT_SECRET=your-hubtel-client-secret
HUBTEL_MERCHANT_ID=your-hubtel-merchant-id
HUBTEL_BASE_URL=https://api.hubtel.com/v1

# Paystack (test mode — for real card payment testing during hackathon)
# Demo Day card flow uses Paystack. Hubtel (MoMo) is still the production target.
PAYSTACK_TEST_PUBLIC_KEY=pk_test_a1edd4233cb500a8b10d38357b594ced33e9c557
PAYSTACK_TEST_SECRET_KEY=pk_test_a1edd4233cb500a8b10d38357b594ced33e9c557
PAYSTACK_BASE_URL=https://api.paystack.co

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SANDBOX_CODE=join your-sandbox-code

# Ghana Card KYC (NIA API - Phase 2)
NIA_API_KEY=your-nia-api-key
NIA_BASE_URL=https://api.nia.gov.gh

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Public backend URL used for Hubtel callbacks (optional until Hubtel is enabled)
API_PUBLIC_URL=https://your-service.onrender.com
